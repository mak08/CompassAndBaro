<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light nautical theme; the dark panels are drawn by the compass and graph views. -->
    <style name="Theme.Comparo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navy_800</item>
        <item name="colorPrimaryVariant">@color/navy_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sea_foam</item>
        <item name="colorSecondaryVariant">@color/navy_600</item>
        <item name="colorOnSecondary">@color/navy_900</item>
        <item name="android:colorBackground">@color/sky_100</item>
        <item name="android:windowBackground">@color/sky_100</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/navy_600</item>
        <item name="android:statusBarColor">@color/navy_900</item>
        <item name="android:navigationBarColor">@color/sky_100</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="SettingsHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textAppearance">?attr/textAppearanceSubtitle1</item>
        <item name="android:textColor">@color/navy_800</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceCaption</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/navy_600</item>
    </style>

    <style name="FieldValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceHeadline4</item>
        <item name="android:textColor">@color/navy_900</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsOption" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
